# Supabase (Settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Legacy JWT (HS256) only — paste "Legacy JWT Secret" if your access tokens use alg HS256.
# If Supabase uses JWT Signing Keys (ECC), leave empty; the API verifies via JWKS (ES256/RS256).
SUPABASE_JWT_SECRET=

# Gmail OAuth (Google Cloud Console → APIs & Services → Credentials)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:8000/auth/gmail/callback

FRONTEND_URL=http://localhost:3000

# Optional HMAC key for Gmail OAuth state (defaults to JWT secret or service_role)
# OAUTH_STATE_SECRET=

# OPENAI_API_KEY=
